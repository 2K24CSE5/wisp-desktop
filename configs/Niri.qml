pragma Singleton
import Quickshell
import Quickshell.Io
import QtQuick
import qs.configs

Singleton {
  id: root

  readonly property string includeLine: 'include "wisp-desktop.kdl"'
  readonly property string colorKey: `${Color.primary}|${Color.subtle}|${Color.error}`

  property bool ready: false
  property bool ignoreNextChange: false
  property string currentContent: ""

  readonly property string defaultWispConfig: `// Auto-generated by wisp-desktop
spawn-sh-at-startup "quickshell -p ~/.config/quickshell/wisp-desktop"
prefer-no-csd

hotkey-overlay {
  skip-at-startup
}

input {
  touchpad {
    tap
    natural-scroll
  }
  mouse {
    natural-scroll
  }
}

layer-rule {
  match namespace="^wisp-wallpaper$"
  place-within-backdrop true
}

overview {
  workspace-shadow {
    off
  }
}

recent-windows {
  highlight {
    active-color "${Color.primary}"
    urgent-color "${Color.error}"
    corner-radius 12
  }
}

layout {
  background-color "transparent"
  focus-ring {
    off
    active-color "${Color.primary}"
    inactive-color "${Color.subtle}"
    urgent-color "${Color.error}"
  }

  border {
    off
    active-color "${Color.primary}"
    inactive-color "${Color.subtle}"
    urgent-color "${Color.error}"
  }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    open-maximized true
}

binds {
  Mod+T {spawn-sh "ghostty"; }
  Mod+D { spawn-sh "quickshell -c wisp-desktop ipc call launcher toggle"; }
  Mod+Q { close-window; }
  Mod+Left { focus-column-left; }
  Mod+Right { focus-column-right; }
}
`

  function applyColors(content: string): string {
    if (!content || content.trim() === "")
      return defaultWispConfig;

    return content.replace(/(\bactive-color\s+)"[^"]*"/g, `$1"${Color.primary}"`).replace(/(\binactive-color\s+)"[^"]*"/g, `$1"${Color.subtle}"`).replace(/(\burgent-color\s+)"[^"]*"/g, `$1"${Color.error}"`);
  }

  function sync(): void {
    if (!ready)
      return;

    const merged = applyColors(currentContent);
    if (merged !== currentContent) {
      currentContent = merged;
      ignoreNextChange = true;
      wispConfigFile.setText(merged);
    }
  }

  onColorKeyChanged: syncDebounce.restart()

  Timer {
    id: syncDebounce
    interval: 50
    onTriggered: root.sync()
  }

  FileView {
    id: wispConfigFile
    path: Paths.ready ? Paths.wispNiriFile : ""
    watchChanges: true
    printErrors: false

    onFileChanged: {
      if (root.ignoreNextChange) {
        root.ignoreNextChange = false;
        return;
      }
      reload();
    }

    onLoaded: {
      root.currentContent = text();
      root.ready = true;
      syncDebounce.restart();
    }

    onLoadFailed: error => {
      if (error === FileViewError.FileNotFound) {
        root.currentContent = "";
        root.ready = true;
        syncDebounce.restart();
      }
    }
  }

  FileView {
    id: mainConfigFile
    path: Paths.ready ? Paths.niriConfigFile : ""
    printErrors: false

    onLoaded: {
      const content = text();
      if (!content.includes(root.includeLine)) {
        const sep = content.length > 0 && !content.endsWith("\n") ? "\n\n" : "\n";
        mainConfigFile.setText(content + sep + root.includeLine + "\n");
      }
    }

    onLoadFailed: error => {
      if (error === FileViewError.FileNotFound)
        mainConfigFile.setText(root.includeLine + "\n");
    }
  }
}
